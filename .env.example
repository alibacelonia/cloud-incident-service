AI_PROVIDER=mock
AI_MODEL=
AWS_REGION=us-east-1
# Directory for one JSON trace per investigation, for example .traces (git-ignored).
# Leave empty to disable trace files.
TRACE_DIR=
# deterministic (default) or model
ORCHESTRATOR=deterministic
MODEL_MAX_OUTPUT_TOKENS=2048
# Set to 1 only when running `pytest -m live` against your own authorized AWS account.
RUN_LIVE_TESTS=0
# Optional. Require this key in the X-API-Key header on /v1/ requests (32+ characters).
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SERVICE_API_KEY=
# Required when AI_PROVIDER=anthropic (with AI_MODEL). Never commit a real key.
ANTHROPIC_API_KEY=
